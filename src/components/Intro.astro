---
import Arrow from '../assets/arrow.svg';
import BubbleText from './BubbleText.astro';
---

<section
  id='intro'
  data-aos='fade-up'
  data-aos-duration='800'
  data-aos-anchor-placement='center-bottom'
  class='w-full md:max-w-220 text-center px-4 md:px-8 xl:px-10 py-10 md:py-14 mx-auto flex flex-col items-center justify-center min-h-dvh gap-y-4'
>
  <h1 class='section-title text-3xl md:text-5xl font-bold inline-flex items-center gap-x-3 text-ink dark:text-white whitespace-nowrap'>
    Hello, I'm <BubbleText text="Ruby" />
  </h1>
  <p class='text-base md:text-xl text-[#5d5367] dark:text-[#e8e1f0] max-w-2xl'>
    I'm a student at Leeds Arts University, and I study photography.
  </p>
  <a href='#personal-work' aria-label='Scroll down to personal work' class='flex items-center justify-center'>
    <Arrow
      class='size-9 motion-safe:animate-bounce text-rose dark:text-pink rounded-full transition-colors duration-300 hover:bg-lilac hover:text-ink dark:hover:bg-pink dark:hover:text-white'
    />
  </a>
</section>
