---
import ThemeToggle from './ThemeToggle.astro';
---

<nav
  id='main-nav'
  class='sticky top-0 z-50 font-medium w-full px-4 md:px-6 xl:px-10 mx-auto transition-all duration-300 border-0 shadow-none transform translate-y-0'
>
  <div class='w-full max-w-[1800px] mx-auto flex flex-col items-center py-3 md:py-5'>
    <ul class='w-full md:w-auto flex items-center justify-center gap-x-1 sm:gap-x-2 md:gap-x-5 px-2 sm:px-3 md:px-6 py-2 md:py-2.5 text-xs sm:text-sm md:text-base text-ink dark:text-white'>
      <li>
        <a
          href='/ruby-portfolio/#intro'
          class='group relative inline-flex items-center rounded-full px-2.5 sm:px-3 md:px-3.5 py-1.5 transition duration-300 hover:bg-white/60 dark:hover:bg-white/10'
        >
          Intro
          <span
            class='pointer-events-none absolute left-2 right-2 bottom-1 h-0.5 origin-left scale-x-0 bg-rose transition-transform duration-300 group-hover:scale-x-100 dark:bg-pink'
          ></span>
        </a>
      </li>
      <li>
        <a
          href='/ruby-portfolio/#personal-work'
          class='group relative inline-flex items-center rounded-full px-2.5 sm:px-3 md:px-3.5 py-1.5 transition duration-300 hover:bg-white/60 dark:hover:bg-white/10'
        >
          Personal Work
          <span
            class='pointer-events-none absolute left-2 right-2 bottom-1 h-0.5 origin-left scale-x-0 bg-rose transition-transform duration-300 group-hover:scale-x-100 dark:bg-pink'
          ></span>
        </a>
      </li>
      <li>
        <a
          href='/ruby-portfolio/#video-work'
          class='group relative inline-flex items-center rounded-full px-2.5 sm:px-3 md:px-3.5 py-1.5 transition duration-300 hover:bg-white/60 dark:hover:bg-white/10'
        >
          Video Work
          <span
            class='pointer-events-none absolute left-2 right-2 bottom-1 h-0.5 origin-left scale-x-0 bg-rose transition-transform duration-300 group-hover:scale-x-100 dark:bg-pink'
          ></span>
        </a>
      </li>
    </ul>
  </div>
</nav>

<ThemeToggle />

<script>
  let lastScrollY = window.scrollY;
  let ticking = false;
  const nav = document.getElementById('main-nav');

  const updateNav = () => {
    const currentScrollY = window.scrollY;

    if (currentScrollY > lastScrollY && currentScrollY > 100) {
      // Scrolling down - hide nav
      nav?.classList.add('-translate-y-full');
      nav?.classList.remove('translate-y-0');
    } else if (currentScrollY < lastScrollY) {
      // Scrolling up - show nav
      nav?.classList.remove('-translate-y-full');
      nav?.classList.add('translate-y-0');
    }

    lastScrollY = currentScrollY;
    ticking = false;
  };

  const onScroll = () => {
    if (!ticking) {
      window.requestAnimationFrame(updateNav);
      ticking = true;
    }
  };

  window.addEventListener('scroll', onScroll, { passive: true });
</script>
