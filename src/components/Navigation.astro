---
import ThemeToggle from './ThemeToggle.astro';
---

<nav
  id='main-nav'
  class='sticky top-0 z-50 font-medium w-full px-4 md:px-6 xl:px-10 mx-auto bg-white/90 dark:bg-black/90 backdrop-blur-sm transition-all duration-300 border-0 shadow-none transform translate-y-0'
>
  <div class='relative flex justify-center w-full items-center py-3 md:py-4'>
    <ul class='flex items-center justify-center gap-x-5 md:gap-x-8 mx-auto text-sm md:text-base text-gray-800 dark:text-white'>
      <li>
        <a href='/ruby-portfolio/#intro' class='group transition duration-300'>
          Intro
          <span
            class='block max-w-0 group-hover:max-w-full transition-all duration-500 h-0.5 bg-rose dark:bg-pink'
          ></span>
        </a>
      </li>
      <li>
        <a href='/ruby-portfolio/#personal-work' class='group transition duration-300'>
          Personal Work
          <span
            class='block max-w-0 group-hover:max-w-full transition-all duration-500 h-0.5 bg-rose dark:bg-pink'
          ></span>
        </a>
      </li>
      <li>
        <a href='/ruby-portfolio/#video-work' class='group transition duration-300'>
          Video Work
          <span
            class='block max-w-0 group-hover:max-w-full transition-all duration-500 h-0.5 bg-rose dark:bg-pink'
          ></span>
        </a>
      </li>
    </ul>
    <div class='absolute right-0 flex items-center'>
      <ThemeToggle />
    </div>
  </div>
</nav>

<script>
  let lastScrollY = window.scrollY;
  let ticking = false;
  const nav = document.getElementById('main-nav');

  const updateNav = () => {
    const currentScrollY = window.scrollY;

    if (currentScrollY > lastScrollY && currentScrollY > 100) {
      // Scrolling down - hide nav
      nav?.classList.add('-translate-y-full');
      nav?.classList.remove('translate-y-0');
    } else if (currentScrollY < lastScrollY) {
      // Scrolling up - show nav
      nav?.classList.remove('-translate-y-full');
      nav?.classList.add('translate-y-0');
    }

    lastScrollY = currentScrollY;
    ticking = false;
  };

  const onScroll = () => {
    if (!ticking) {
      window.requestAnimationFrame(updateNav);
      ticking = true;
    }
  };

  window.addEventListener('scroll', onScroll, { passive: true });
</script>
